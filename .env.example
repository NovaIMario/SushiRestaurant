# Copy to .env for local use. Never commit the real .env.

# Password for /admin. The admin page is off until this is set. Use a long one.
ADMIN_PASSWORD=

# Random string that signs the admin login cookie. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Leave empty locally (a SQLite file in data/ is used).
# On Render, set it to a Postgres connection string (e.g. a new Supabase project's
# "Session pooler" URI) so bookings survive deploys.
DATABASE_URL=

# Optional
# BOOKING_DAYS_AHEAD=60
# RESTAURANT_TIMEZONE=Europe/London
